@model List<auth.ViewModels.Manager.ManagerReservationViewModel>
@{
    ViewData["Title"] = "Réservations";
    var parking = ViewBag.Parking as auth.Models.Parking;
    var day = (string)(ViewBag.Day ?? DateTime.Today.ToString("yyyy-MM-dd"));
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2 class="mb-1">Réservations</h2>
            <div class="text-muted">@parking?.Name</div>
        </div>
        <div class="d-flex gap-2">
            <a class="sp-btn sp-btn-outline" asp-controller="Manager" asp-action="Details" asp-route-id="@parking?.Id">
                Retour parking
            </a>
        </div>
    </div>

    <div class="sp-card p-3 mb-3">
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="parkingId" value="@parking?.Id" />
            <div class="col-md-3">
                <label class="form-label">Jour</label>
                <input class="form-control" type="date" name="day" value="@day" />
            </div>
            <div class="col-md-3">
                <button class="sp-btn sp-btn-primary" type="submit">
                    <i class="bi bi-search"></i> Afficher
                </button>
            </div>
        </form>
    </div>

    <div class="sp-card p-3">
        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <i class="bi bi-calendar-x display-6 text-muted"></i>
                <p class="text-muted mt-2 mb-0">Aucune réservation pour ce jour.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Heure</th>
                            <th>Place</th>
                            <th>Utilisateur</th>
                            <th>Durée (h)</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.StartAt.ToString("HH:mm")</td>
                                <td class="fw-bold">@r.SpotCode</td>
                                <td class="text-muted small">@r.UserEmail</td>
                                <td>@r.DurationHours</td>
                                <td>@r.TotalPrice.ToString("0.00")</td>
                                <td>
                                    <span class="badge @(r.Status == "Confirmed" ? "bg-success" : "bg-secondary")">
                                        @r.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
