@model List<auth.Models.Parking>
@{
    ViewData["Title"] = "Dashboard Manager";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Dashboard Manager</h2>
            <p class="text-muted mb-0">Gérez vos parkings, vos places et consultez les réservations.</p>
        </div>
        <a class="sp-btn sp-btn-primary" asp-controller="Manager" asp-action="CreateParking">
            <i class="bi bi-plus-circle"></i> Ajouter un parking
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="sp-card p-4">
            <h5 class="mb-2">Aucun parking</h5>
            <p class="text-muted mb-3">Ajoutez votre premier parking pour commencer.</p>
            <a class="sp-btn sp-btn-primary" asp-controller="Manager" asp-action="CreateParking">
                Ajouter un parking
            </a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var p in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="sp-card p-3 h-100">
                        <h5 class="mb-1">@p.Name</h5>
                        <div class="text-muted small mb-2">@p.Address</div>

                        <div class="d-flex gap-2 flex-wrap mb-2">
                            <a class="sp-btn sp-btn-outline" asp-controller="Manager" asp-action="Details" asp-route-id="@p.Id">
                                <i class="bi bi-gear"></i> Gérer
                            </a>
                            <a class="sp-btn sp-btn-light" asp-controller="Manager" asp-action="Reservations" asp-route-parkingId="@p.Id" asp-route-day="@DateTime.Today.ToString("yyyy-MM-dd")">
                                <i class="bi bi-calendar2-week"></i> Réservations
                            </a>
                        </div>

                        <hr />
                        <div class="small text-muted">
                            Coordonnées : @p.Latitude , @p.Longitude
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
