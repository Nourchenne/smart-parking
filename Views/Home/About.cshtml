@{
    ViewData["Title"] = "À propos";
}

<section class="sp-section">
    <div class="container">
        <div class="sp-section-header">
            <h2>À propos de Smart Parking</h2>
            <p>Une solution intelligente pour simplifier la gestion du stationnement.</p>
        </div>

        <div class="row align-items-center mt-5">
            <div class="col-md-6 mb-4">
                <h4>Notre vision</h4>
                <p>
                    Smart Parking est une plateforme innovante conçue pour connecter
                    les conducteurs et les gestionnaires de parkings dans un environnement
                    numérique simple, rapide et fiable.
                </p>
                <p>
                    Notre objectif est de réduire le stress lié à la recherche de stationnement,
                    d’optimiser l’occupation des parkings et d’offrir une gestion centralisée,
                    sécurisée et en temps réel.
                </p>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card p-4 shadow-sm">
                    <h5>Fonctionnalités clés</h5>
                    <ul class="mt-3">
                        <li>🔎 Recherche de parkings par zone géographique</li>
                        <li>📅 Consultation de la disponibilité par date et heure</li>
                        <li>⏱ Calcul automatique du prix selon la durée</li>
                        <li>📊 Tableau de bord Manager pour le suivi quotidien</li>
                        <li>🧾 Historique complet des réservations</li>
                        <li>🔐 Gestion sécurisée des comptes (User, Manager, SuperAdmin)</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-md-4 mb-3">
                <div class="card h-100 text-center p-3">
                    <i class="bi bi-people display-5 text-danger"></i>
                    <h5 class="mt-3">Pour les utilisateurs</h5>
                    <p>
                        Trouvez une place facilement, réservez en quelques clics
                        et consultez votre historique de stationnement.
                    </p>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card h-100 text-center p-3">
                    <i class="bi bi-building display-5 text-danger"></i>
                    <h5 class="mt-3">Pour les managers</h5>
                    <p>
                        Gérez vos parkings, définissez les prix,
                        visualisez les réservations quotidiennes
                        et optimisez votre activité.
                    </p>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card h-100 text-center p-3">
                    <i class="bi bi-shield-lock display-5 text-danger"></i>
                    <h5 class="mt-3">Pour l'administration</h5>
                    <p>
                        Supervision globale du système,
                        gestion des comptes et contrôle
                        de l’ensemble de la plateforme.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
