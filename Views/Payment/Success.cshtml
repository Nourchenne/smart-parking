@model auth.ViewModels.PaymentReceiptViewModel
@{
    ViewData["Title"] = "Paiement réussi";
}

<div class="container mt-4">
    <div class="alert alert-success">
        ? Paiement réussi. Réservation #@Model.ReservationId confirmée.
    </div>

    <div class="card p-3 mb-3">
        <p><strong>Utilisateur :</strong> @Model.UserEmail</p>
        <p><strong>Parking :</strong> @Model.ParkingName</p>
        <p><strong>Place :</strong> @Model.SpotCode</p>
        <p><strong>Début :</strong> @Model.StartAt.ToString("g")</p>
        <p><strong>Fin :</strong> @Model.EndAt.ToString("g")</p>
        <p><strong>Durée :</strong> @Model.DurationHours h</p>
        <p><strong>Montant :</strong> @Model.TotalPrice.ToString("0.00") €</p>
        <p><strong>Réf paiement :</strong> @Model.PaymentRef</p>
        <p><strong>Payé le :</strong> @Model.PaidAt?.ToString("g")</p>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-controller="Payment" asp-action="DownloadReceipt" asp-route-reservationId="@Model.ReservationId">Télécharger le reçu</a>
        <a class="btn btn-secondary" asp-controller="Reservations" asp-action="Details" asp-route-id="@Model.ReservationId">Voir la réservation</a>
    </div>
</div>
