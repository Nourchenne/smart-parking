@model int
@{
    ViewData["Title"] = "Paiement échoué";
}
<div class="container mt-4">
    <div class="alert alert-danger">
        ? Paiement échoué. Réservation #@Model non payée. Vous pouvez réessayer.
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-warning" asp-controller="Payment" asp-action="Pay" asp-route-reservationId="@Model">Réessayer</a>
        <a class="btn btn-secondary" asp-controller="Reservations" asp-action="Details" asp-route-id="@Model">Voir la réservation</a>
    </div>
</div>
