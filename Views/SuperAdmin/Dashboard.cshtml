@model auth.ViewModels.SuperAdmin.DashboardViewModel

@{
    ViewData["Title"] = "SuperAdmin Dashboard";
    var currentEmail = User?.Identity?.Name ?? "";
}

<h2>Bienvenue SuperAdmin</h2>
<p>Gestion complète du système Smart Parking.</p>

<form asp-action="Logout" method="post" class="disable-on-submit">
    @Html.AntiForgeryToken()
    <button class="sp-btn sp-btn-danger">Se déconnecter</button>
</form>

<div class="container py-4">
    <h2 class="mb-3">SuperAdmin - Tableau de bord</h2>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="sp-card p-3 text-center">
                <h4>@Model.TotalUsers</h4>
                <div class="text-muted">Utilisateurs</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sp-card p-3 text-center">
                <h4>@Model.TotalManagers</h4>
                <div class="text-muted">Managers</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sp-card p-3 text-center">
                <h4>@Model.TotalParkings</h4>
                <div class="text-muted">Parkings</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sp-card p-3 text-center">
                <h4>@Model.TotalReservations</h4>
                <div class="text-muted">Réservations</div>
            </div>
        </div>
    </div>

    <div class="sp-card p-3">
        <h5>Utilisateurs</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td>@u.Email</td>
                            <td>@string.Join(", ", u.Roles)</td>
                            <td>@(u.IsLocked ? "Bloqué" : "Actif")</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <form method="post" asp-action="ToggleLock" class="d-inline disable-on-submit">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button class="sp-btn sp-btn-primary" type="submit" title="Activer / Désactiver">
                                            @(u.IsLocked ? "Activer" : "Désactiver")
                                        </button>
                                    </form>

                                    @if (!string.Equals(u.Email, currentEmail, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form method="post" asp-action="DeleteUser" class="d-inline disable-on-submit" onsubmit="return confirm('Supprimer cet utilisateur ?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <button class="sp-btn sp-btn-light" type="submit" title="Supprimer utilisateur">Supprimer</button>

                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
