@model List<auth.Models.ContactMessage>
@{
    ViewData["Title"] = "Messages de contact";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Messages de contact</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-4 text-center">Aucun message.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var m in Model)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="mb-1">@m.Subject</h5>
                            <small class="text-muted">De: @m.FullName - @m.Email</small>
                        </div>
                        <div class="text-muted">@m.CreatedAt.ToLocalTime().ToString("g")</div>
                    </div>
                    <p class="mt-2">@m.Message</p>
                    <div class="d-flex gap-2">
                        <form method="post" asp-controller="SuperAdmin" asp-action="ToggleContactRead" onsubmit="return true;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@m.Id" />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">@(m.IsRead ? "Marquer non lu" : "Marquer lu")</button>
                        </form>
                        <form method="post" asp-controller="SuperAdmin" asp-action="DeleteContactMessage" onsubmit="return confirm('Supprimer ce message ?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@m.Id" />
                            <button class="btn btn-sm btn-danger" type="submit">Supprimer</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>