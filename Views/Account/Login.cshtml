@model auth.Models.LoginViewModel

@{
    ViewData["Title"] = "Connexion";
}

<section class="sp-section">
    <div class="container" style="max-width: 520px;">
        <div class="sp-auth-card">
            <div class="sp-auth-header">
                <span class="sp-badge">🔐 Connexion</span>
                <h2 class="sp-auth-title">Accéder à votre espace</h2>
                <p class="sp-auth-subtitle">Connectez-vous pour réserver et gérer vos parkings.</p>
            </div>

            <form asp-action="Login" method="post" class="sp-auth-form">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label sp-label"></label>
                    <input asp-for="Email" class="form-control sp-input" placeholder="ex: name@email.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label sp-label"></label>
                    <input asp-for="Password" class="form-control sp-input" placeholder="Votre mot de passe" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SelectedRole" class="form-label sp-label"></label>
                    <select asp-for="SelectedRole" class="form-select sp-input">
                        <option value="User">Utilisateur</option>
                        <option value="Manager">Manager (Gérant)</option>
                    </select>
                    <span asp-validation-for="SelectedRole" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check m-0">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label sp-check-label"></label>
                    </div>

                    <a class="sp-link" asp-controller="Account" asp-action="ForgotPassword">Mot de passe oublié ?</a>
                </div>

                <button type="submit" class="sp-btn sp-btn-primary w-100">Se connecter</button>

                <div class="text-center mt-3">
                    <span class="sp-muted">Pas encore de compte ?</span>
                    <a class="sp-link" asp-action="Register">Créer un compte</a>
                </div>
            </form>
        </div>
    </div>
</section>
