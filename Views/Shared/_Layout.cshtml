<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Parking</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark site-navbar" role="navigation" aria-label="Barre de navigation principale">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Smart Parking
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Basculer la navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        

                        @* Role-specific links: visible only when authenticated *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-lock"></i> SuperAdmin
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="adminMenu">
                                        <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="Dashboard">Tableau de bord</a></li>
                                        <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="Users">Utilisateurs</a></li>
                                        <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="Parkings">Parkings</a></li>
                                        <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="Reservations">Réservations</a></li>
                                        <li><a class="dropdown-item" asp-controller="Home" asp-action="ContactMessages">Messages de contact</a></li>
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="managerMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-briefcase"></i> Manager
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="managerMenu">
                                        <li><a class="dropdown-item" asp-controller="Manager" asp-action="Dashboard">Tableau de bord</a></li>
                                        <li><a class="dropdown-item" asp-controller="Manager" asp-action="CreateParking">Créer un parking</a></li>

                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("User"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="User" asp-action="Dashboard"><i class="bi bi-person-square"></i> Mon espace</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reservations" asp-action="MyReservations"><i class="bi bi-calendar-check"></i> Mes réservations</a>
                                </li>
                            }
                        }

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About"><i class="bi bi-info-circle"></i> À propos</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                    @* Do not show "Mon compte" for SuperAdmin *@
                                    @if (!User.IsInRole("SuperAdmin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Manage">Mon compte</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }

                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-logout w-100" type="submit">Se déconnecter</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Connexion</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Inscription</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            }

            @RenderBody()
        </main>
    </main>

    <footer class="site-footer mt-5">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>&copy; @DateTime.Now.Year - Smart Parking</div>
            <div class="d-flex gap-3 align-items-center">
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                <a asp-controller="Home" asp-action="Contact">Contact</a>
                <a href="#" aria-label="Twitter" class="text-decoration-none text-muted"><i class="bi bi-twitter"></i></a>
                <a href="#" aria-label="Github" class="text-decoration-none text-muted"><i class="bi bi-github"></i></a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/site-admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
